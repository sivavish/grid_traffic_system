# ASTraM live feed configuration
# Use semicolon-separated URLs. Leave a value empty to fall back to the bundled defaults in backend/feed_sources.py.

ASTRAM_RSS_FEEDS=
ASTRAM_TRAFFIC_ALERT_FEEDS=
ASTRAM_PUBLIC_EVENT_CALENDARS=
ASTRAM_CITIZEN_REPORTS=

